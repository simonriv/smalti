    "“All” means other computers on your network can connect. The list is lsof’s (TCP in LISTEN and unconnected UDP), only for your processes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“All” means other computers on your network can connect. The list is lsof’s (TCP in LISTEN and unconnected UDP), only for your processes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Todas» significa que otros equipos de tu red pueden conectarse. La lista es la de lsof (TCP en escucha y UDP sin conexión), solo de tus procesos."
          }
        }
      }
    }
  },
  "version": "1.0"
}
